# Krondle - Environment Variables Template
# Copie este arquivo para .env e preencha com suas credenciais

# API Base URL (quando backend estiver pronto)
VITE_API_URL=http://localhost:8000

# Supabase (quando configurarem)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI (para IA)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Meta API (WhatsApp & Instagram)
VITE_META_APP_ID=your_meta_app_id_here
VITE_META_APP_SECRET=your_meta_app_secret_here
VITE_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
VITE_WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# Gmail API
VITE_GMAIL_CLIENT_ID=your_gmail_client_id_here
VITE_GMAIL_CLIENT_SECRET=your_gmail_client_secret_here

# Environment
VITE_ENV=development

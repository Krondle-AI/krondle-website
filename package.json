{
  "name": "krondle",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo Run this from inside apps/marketing or apps/dashboard",
    "dev:marketing": "pnpm --filter @krondle/marketing dev",
    "dev:dashboard": "pnpm --filter @krondle/dashboard dev"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "^5.4.21"
    }
  }
}
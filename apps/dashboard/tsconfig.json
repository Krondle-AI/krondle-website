{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@krondle/common": ["../../packages/common/src/index.ts"],
      "@krondle/common/*": ["../../packages/common/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}